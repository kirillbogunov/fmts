// Общий модуль: TOIRWebAPI
// Сервер = Да, Вызов сервера = Да, Экспорт = Да.
// Назначение: после записи Документ.ЗаявкаХозОтдела отправить карточку в FMTS.
// ВАЖНО: замените ХостTOIR(), ПортTOIR() и ТокенTOIR() ниже.

Функция ХостTOIR() Экспорт
    // Если ТОиР работает на том же сервере: 127.0.0.1
    // Если на другом ПК в локальной сети: его LAN IP, например 192.168.1.50
    Возврат "127.0.0.1";
КонецФункции

Функция ПортTOIR() Экспорт
    Возврат 8000;
КонецФункции

Функция ТокенTOIR() Экспорт
    // Должен совпадать с ONEC_WEBHOOK_TOKEN в .env приложения.
    Возврат "CHANGE_THIS_TO_SAME_VALUE_AS_ONEC_WEBHOOK_TOKEN";
КонецФункции

Процедура ОтправитьЗаявку(СсылкаНаЗаявку) Экспорт
    Если НЕ ЗначениеЗаполнено(СсылкаНаЗаявку) Тогда
        Возврат;
    КонецЕсли;

    Попытка
        Объект = СсылкаНаЗаявку.ПолучитьОбъект();

        Данные = Новый Структура;
        Данные.Вставить("id", Строка(СсылкаНаЗаявку.УникальныйИдентификатор()));
        Попытка Данные.Вставить("web_id", БезопаснаяСтрока(Объект.WebID)); Исключение Данные.Вставить("web_id", ""); КонецПопытки;
        Данные.Вставить("number", Строка(СсылкаНаЗаявку.Номер));
        Данные.Вставить("date", Формат(СсылкаНаЗаявку.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
        Данные.Вставить("requester", БезопаснаяСтрока(Объект.Заявитель));
        Данные.Вставить("department_id", GUIDСсылки(Объект.Подразделение));
        Данные.Вставить("department", БезопаснаяСтрока(Объект.Подразделение));
        Данные.Вставить("room", БезопаснаяСтрока(Объект.Кабинет));
        Данные.Вставить("phone", БезопаснаяСтрока(Объект.Телефон));
        Данные.Вставить("category", БезопаснаяСтрока(Объект.Категория));
        Данные.Вставить("priority", БезопаснаяСтрока(Объект.Приоритет));
        Данные.Вставить("description", БезопаснаяСтрока(Объект.Описание));
        Данные.Вставить("master", БезопаснаяСтрока(Объект.Мастер));
        Данные.Вставить("status", БезопаснаяСтрока(Объект.Статус));

        Попытка
            Если ЗначениеЗаполнено(Объект.ДатаВыполнения) Тогда
                Данные.Вставить("resolved_at", Формат(Объект.ДатаВыполнения, "ДФ=yyyy-MM-ddTHH:mm:ss"));
            Иначе
                Данные.Вставить("resolved_at", "");
            КонецЕсли;
        Исключение
            Данные.Вставить("resolved_at", "");
        КонецПопытки;

        Попытка
            Данные.Вставить("master_comment", БезопаснаяСтрока(Объект.КомментарийМастера));
        Исключение
            Данные.Вставить("master_comment", "");
        КонецПопытки;

        // Эти реквизиты добавляются на этапе полного ТОиР. Пока их отсутствие не мешает обмену.
        Попытка Данные.Вставить("labor_cost", Объект.СтоимостьРабот); Исключение Данные.Вставить("labor_cost", 0); КонецПопытки;
        Попытка Данные.Вставить("parts_cost", Объект.СтоимостьМатериалов); Исключение Данные.Вставить("parts_cost", 0); КонецПопытки;

        Тело = ВJSON(Данные);
        Соединение = Новый HTTPСоединение(ХостTOIR(), ПортTOIR());
        HTTPЗапрос = Новый HTTPЗапрос("/api/1c/webhook/tickets");
        HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        HTTPЗапрос.Заголовки.Вставить("Accept", "application/json");
        HTTPЗапрос.Заголовки.Вставить("X-TOIR-TOKEN", ТокенTOIR());
        HTTPЗапрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

        HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
        Если HTTPОтвет.КодСостояния < 200 ИЛИ HTTPОтвет.КодСостояния >= 300 Тогда
            ЗаписьЖурналаРегистрации("TOIRWebAPI", УровеньЖурналаРегистрации.Ошибка, , ,
                "Ошибка отправки заявки в ТОиР. HTTP " + Строка(HTTPОтвет.КодСостояния) + ": " + HTTPОтвет.ПолучитьТелоКакСтроку());
        КонецЕсли;
    Исключение
        // Не блокируем запись документа 1С, если веб-сервис временно недоступен.
        ЗаписьЖурналаРегистрации("TOIRWebAPI", УровеньЖурналаРегистрации.Ошибка, , ,
            "Не удалось отправить ЗаявкаХозОтдела в ТОиР: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

Функция GUIDСсылки(Значение) Экспорт
    Попытка
        Если НЕ ЗначениеЗаполнено(Значение) Тогда Возврат ""; КонецЕсли;
        Возврат Строка(Значение.УникальныйИдентификатор());
    Исключение
        Возврат "";
    КонецПопытки;
КонецФункции

Функция БезопаснаяСтрока(Значение) Экспорт
    Если Значение = Неопределено Тогда Возврат ""; КонецЕсли;
    Возврат Строка(Значение);
КонецФункции

Функция ВJSON(Данные) Экспорт
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Возврат Запись.Закрыть();
КонецФункции

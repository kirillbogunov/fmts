// Добавьте эти две функции в модуль HTTP-сервиса TOIR
// ПОСЛЕ создания справочника ОборудованиеХозОтдела по WHAT_TO_ADD.md.
// Ресурс /equipment: GET -> EquipmentGET, POST -> EquipmentPOST.

Функция EquipmentGET(Запрос) Экспорт
    Массив = Новый Массив;
    Выборка = Справочники.ОборудованиеХозОтдела.Выбрать();
    Пока Выборка.Следующий() Цикл
        Если Выборка.ЭтоГруппа Тогда Продолжить; КонецЕсли;
        Стр = Новый Структура;
        Стр.Вставить("id", GUIDСсылки(Выборка.Ссылка));
        Стр.Вставить("name", Строка(Выборка.Наименование));
        Стр.Вставить("inventory_no", Строка(Выборка.ИнвентарныйНомер));
        Стр.Вставить("site_id", GUIDСсылки(Выборка.Подразделение));
        Стр.Вставить("site_name", Строка(Выборка.Подразделение));
        Стр.Вставить("category", Строка(Выборка.КатегорияОборудования));
        Стр.Вставить("model", Строка(Выборка.Модель));
        Стр.Вставить("serial_no", Строка(Выборка.СерийныйНомер));
        Стр.Вставить("status", Строка(Выборка.Статус));
        Массив.Добавить(Стр);
    КонецЦикла;
    Возврат JSONОтвет(200, Новый Структура("items", Массив));
КонецФункции

Функция EquipmentPOST(Запрос) Экспорт
    Попытка
        Данные = ИзJSON(Запрос.ПолучитьТелоКакСтроку());
        ID = ""; Данные.Свойство("id", ID);
        Если ЗначениеЗаполнено(ID) Тогда
            Попытка Элемент = Справочники.ОборудованиеХозОтдела.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка(ID))).ПолучитьОбъект(); Исключение Элемент = Неопределено; КонецПопытки;
        Иначе
            Элемент = Неопределено;
        КонецЕсли;
        Если Элемент = Неопределено Тогда Элемент = Справочники.ОборудованиеХозОтдела.СоздатьЭлемент(); КонецЕсли;

        Значение = "";
        Если Данные.Свойство("name", Значение) Тогда Элемент.Наименование = Строка(Значение); КонецЕсли;
        Если Данные.Свойство("inventory_no", Значение) Тогда Элемент.ИнвентарныйНомер = Строка(Значение); КонецЕсли;
        Если Данные.Свойство("category", Значение) Тогда Элемент.КатегорияОборудования = Строка(Значение); КонецЕсли;
        Если Данные.Свойство("model", Значение) Тогда Элемент.Модель = Строка(Значение); КонецЕсли;
        Если Данные.Свойство("serial_no", Значение) Тогда Элемент.СерийныйНомер = Строка(Значение); КонецЕсли;

        IDПодр = ""; ИмяПодр = "";
        Данные.Свойство("site_id", IDПодр); Данные.Свойство("site_name", ИмяПодр);
        Подр = НайтиПодразделение(IDПодр, ИмяПодр);
        Если ЗначениеЗаполнено(Подр) Тогда Элемент.Подразделение = Подр; КонецЕсли;
        Элемент.Записать();
        Возврат JSONОтвет(200, Новый Структура("ok,id", Истина, GUIDСсылки(Элемент.Ссылка)));
    Исключение
        Возврат JSONОтвет(500, Новый Структура("ok,message", Ложь, ОписаниеОшибки()));
    КонецПопытки;
КонецФункции

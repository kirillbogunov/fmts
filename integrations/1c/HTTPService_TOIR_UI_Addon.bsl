// Добавить в модуль HTTP-сервиса TOIR.
// В дереве HTTP-сервиса создать шаблон URL: /ui
// Метод: GET
// Обработчик: GET_UI
//
// Источник данных: РегистрСведений.НастройкиПодсветкиТОИР

Функция GET_UI(Запрос)
    Попытка
        Массив = Новый Массив;

        ЗапросДанных = Новый Запрос;
        ЗапросДанных.Текст =
        "ВЫБРАТЬ
        |   Настройки.Тип КАК Тип,
        |   Настройки.Код КАК Код,
        |   Настройки.Наименование КАК Наименование,
        |   Настройки.ЦветФона КАК ЦветФона,
        |   Настройки.ЦветТекста КАК ЦветТекста,
        |   Настройки.ЦветГраницы КАК ЦветГраницы,
        |   Настройки.SLAЧасов КАК SLAЧасов,
        |   Настройки.Порядок КАК Порядок,
        |   Настройки.Активен КАК Активен
        |ИЗ
        |   РегистрСведений.НастройкиПодсветкиТОИР КАК Настройки
        |ГДЕ
        |   Настройки.Активен = ИСТИНА
        |УПОРЯДОЧИТЬ ПО
        |   Настройки.Тип,
        |   Настройки.Порядок";

        Выборка = ЗапросДанных.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Стр = Новый Структура;
            Стр.Вставить("kind", Строка(Выборка.Тип));
            Стр.Вставить("code", Строка(Выборка.Код));
            Стр.Вставить("name", Строка(Выборка.Наименование));
            Стр.Вставить("bg_color", Строка(Выборка.ЦветФона));
            Стр.Вставить("text_color", Строка(Выборка.ЦветТекста));
            Стр.Вставить("border_color", Строка(Выборка.ЦветГраницы));
            Стр.Вставить("sla_hours", Выборка.SLAЧасов);
            Стр.Вставить("sort_order", Выборка.Порядок);
            Стр.Вставить("active", Выборка.Активен);
            Массив.Добавить(Стр);
        КонецЦикла;

        ОтветДанные = Новый Структура;
        ОтветДанные.Вставить("items", Массив);
        Возврат JSONОтвет(200, ОтветДанные);
    Исключение
        Возврат JSONОтвет(500, Новый Структура("ok,message", Ложь, ОписаниеОшибки()));
    КонецПопытки;
КонецФункции

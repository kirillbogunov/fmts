// HTTP-сервис: TOIR
// Корневой URL: /hs/toir/v1
// Шаблоны URL:
//   /sites   GET  -> SitesGET
//   /tickets GET  -> TicketsGET
//   /tickets POST -> TicketsPOST
//
// Этот CORE-модуль использует только уже существующие объекты:
// Документ.ЗаявкаХозОтдела, Справочник.Подразделения,
// Перечисления Статусы / Приоритет / Категория.

Функция SitesGET(Запрос) Экспорт
    Массив = Новый Массив;
    Выборка = Справочники.Подразделения.Выбрать();
    Пока Выборка.Следующий() Цикл
        Если Выборка.ЭтоГруппа Тогда Продолжить; КонецЕсли;
        Стр = Новый Структура;
        Стр.Вставить("id", GUIDСсылки(Выборка.Ссылка));
        Стр.Вставить("name", Строка(Выборка.Наименование));
        Попытка Стр.Вставить("address", Строка(Выборка.Адрес)); Исключение Стр.Вставить("address", ""); КонецПопытки;
        Массив.Добавить(Стр);
    КонецЦикла;
    Возврат JSONОтвет(200, Новый Структура("items", Массив));
КонецФункции


Функция EquipmentGET(Запрос) Экспорт
    // Заглушка ядра: после добавления Справочник.ОборудованиеХозОтдела
    // замените обработчик на версию из HTTPService_TOIR_Equipment_Addon.bsl.
    Возврат JSONОтвет(200, Новый Структура("items,message", Новый Массив, "Справочник оборудования ещё не подключен в 1С"));
КонецФункции

Функция InventoryGET(Запрос) Экспорт
    // Не угадываем регистр остатков вашей конфигурации.
    // После определения регистра ЗИП замените этот обработчик.
    Возврат JSONОтвет(200, Новый Структура("items,message", Новый Массив, "Регистр остатков ЗИП ещё не сопоставлен"));
КонецФункции

Функция TicketsGET(Запрос) Экспорт
    Массив = Новый Массив;
    Запрос1С = Новый Запрос;
    Запрос1С.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1000
    |   З.Ссылка КАК Ссылка,
    |   З.WebID КАК WebID,
    |   З.Номер КАК Номер,
    |   З.Дата КАК Дата,
    |   З.Заявитель КАК Заявитель,
    |   З.Подразделение КАК Подразделение,
    |   З.Кабинет КАК Кабинет,
    |   З.Телефон КАК Телефон,
    |   З.Категория КАК Категория,
    |   З.Приоритет КАК Приоритет,
    |   З.Описание КАК Описание,
    |   З.Мастер КАК Мастер,
    |   З.Статус КАК Статус,
    |   З.ДатаВыполнения КАК ДатаВыполнения,
    |   З.КомментарийМастера КАК КомментарийМастера
    |ИЗ Документ.ЗаявкаХозОтдела КАК З
    |ГДЕ НЕ З.ПометкаУдаления
    |УПОРЯДОЧИТЬ ПО З.Дата УБЫВ";

    Выборка = Запрос1С.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Стр = Новый Структура;
        Стр.Вставить("id", GUIDСсылки(Выборка.Ссылка));
        Стр.Вставить("web_id", Строка(Выборка.WebID));
        Стр.Вставить("number", Строка(Выборка.Номер));
        Стр.Вставить("date", Формат(Выборка.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
        Стр.Вставить("requester", Строка(Выборка.Заявитель));
        Стр.Вставить("department_id", GUIDСсылки(Выборка.Подразделение));
        Стр.Вставить("department", Строка(Выборка.Подразделение));
        Стр.Вставить("room", Строка(Выборка.Кабинет));
        Стр.Вставить("phone", Строка(Выборка.Телефон));
        Стр.Вставить("category", Строка(Выборка.Категория));
        Стр.Вставить("priority", Строка(Выборка.Приоритет));
        Стр.Вставить("description", Строка(Выборка.Описание));
        Стр.Вставить("master", Строка(Выборка.Мастер));
        Стр.Вставить("status", Строка(Выборка.Статус));
        Если ЗначениеЗаполнено(Выборка.ДатаВыполнения) Тогда
            Стр.Вставить("resolved_at", Формат(Выборка.ДатаВыполнения, "ДФ=yyyy-MM-ddTHH:mm:ss"));
        Иначе
            Стр.Вставить("resolved_at", "");
        КонецЕсли;
        Стр.Вставить("master_comment", Строка(Выборка.КомментарийМастера));
        Массив.Добавить(Стр);
    КонецЦикла;
    Возврат JSONОтвет(200, Новый Структура("items", Массив));
КонецФункции

Функция TicketsPOST(Запрос) Экспорт
    Попытка
        Данные = ИзJSON(Запрос.ПолучитьТелоКакСтроку());
        ОбъектДок = ПолучитьИлиСоздатьЗаявку(Данные);

        Значение = Неопределено;
        Если Данные.Свойство("web_id", Значение) Тогда
            Попытка ОбъектДок.WebID = Строка(Значение); Исключение КонецПопытки;
        КонецЕсли;

        Значение = Неопределено;
        Если Данные.Свойство("requester", Значение) Тогда
            Попытка ОбъектДок.Заявитель = Строка(Значение); Исключение КонецПопытки;
        КонецЕсли;

        IDПодразделения = "";
        ИмяПодразделения = "";
        Данные.Свойство("department_id", IDПодразделения);
        Данные.Свойство("department", ИмяПодразделения);
        Подразделение = НайтиПодразделение(IDПодразделения, ИмяПодразделения);
        Если ЗначениеЗаполнено(Подразделение) Тогда ОбъектДок.Подразделение = Подразделение; КонецЕсли;

        Если Данные.Свойство("room", Значение) Тогда ОбъектДок.Кабинет = Строка(Значение); КонецЕсли;
        Если Данные.Свойство("phone", Значение) Тогда ОбъектДок.Телефон = Строка(Значение); КонецЕсли;
        Если Данные.Свойство("description", Значение) Тогда ОбъектДок.Описание = Строка(Значение); КонецЕсли;
        Если Данные.Свойство("master", Значение) Тогда ОбъектДок.Мастер = Строка(Значение); КонецЕсли;
        Если Данные.Свойство("master_comment", Значение) Тогда ОбъектДок.КомментарийМастера = Строка(Значение); КонецЕсли;

        Если Данные.Свойство("status", Значение) Тогда
            ЗначениеПеречисления = ЗначениеСтатуса(Строка(Значение));
            Если ЗначениеПеречисления <> Неопределено Тогда ОбъектДок.Статус = ЗначениеПеречисления; КонецЕсли;
        КонецЕсли;
        Если Данные.Свойство("priority", Значение) Тогда
            ЗначениеПеречисления = ЗначениеПриоритета(Строка(Значение));
            Если ЗначениеПеречисления <> Неопределено Тогда ОбъектДок.Приоритет = ЗначениеПеречисления; КонецЕсли;
        КонецЕсли;
        Если Данные.Свойство("category", Значение) Тогда
            ЗначениеПеречисления = ЗначениеКатегории(Строка(Значение));
            Если ЗначениеПеречисления <> Неопределено Тогда ОбъектДок.Категория = ЗначениеПеречисления; КонецЕсли;
        КонецЕсли;

        Если Данные.Свойство("resolved_at", Значение) И ЗначениеЗаполнено(Значение) Тогда
            ДатаВыполнения = ISOВДату(Строка(Значение));
            Если ДатаВыполнения <> Неопределено Тогда ОбъектДок.ДатаВыполнения = ДатаВыполнения; КонецЕсли;
        КонецЕсли;

        // Дополнительные реквизиты полного ТОиР, если они уже добавлены.
        Если Данные.Свойство("labor_cost", Значение) Тогда Попытка ОбъектДок.СтоимостьРабот = Значение; Исключение КонецПопытки; КонецЕсли;
        Если Данные.Свойство("parts_cost", Значение) Тогда Попытка ОбъектДок.СтоимостьМатериалов = Значение; Исключение КонецПопытки; КонецЕсли;

        ОбъектДок.Записать();

        Результат = Новый Структура;
        Результат.Вставить("ok", Истина);
        Результат.Вставить("id", GUIDСсылки(ОбъектДок.Ссылка));
        Результат.Вставить("number", Строка(ОбъектДок.Номер));
        Возврат JSONОтвет(200, Результат);
    Исключение
        Возврат JSONОтвет(500, Новый Структура("ok,message", Ложь, ОписаниеОшибки()));
    КонецПопытки;
КонецФункции

Функция ПолучитьИлиСоздатьЗаявку(Данные)
    ID = "";
    Данные.Свойство("id", ID);
    Если ЗначениеЗаполнено(ID) Тогда
        Попытка
            СсылкаДок = Документы.ЗаявкаХозОтдела.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка(ID)));
            ОбъектДок = СсылкаДок.ПолучитьОбъект();
            Если ОбъектДок <> Неопределено Тогда Возврат ОбъектДок; КонецЕсли;
        Исключение
        КонецПопытки;
    КонецЕсли;
    Возврат Документы.ЗаявкаХозОтдела.СоздатьДокумент();
КонецФункции

Функция НайтиПодразделение(ID, Имя)
    Если ЗначениеЗаполнено(ID) Тогда
        Попытка
            Ссылка = Справочники.Подразделения.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка(ID)));
            Если ЗначениеЗаполнено(Ссылка) Тогда Возврат Ссылка; КонецЕсли;
        Исключение
        КонецПопытки;
    КонецЕсли;
    Если ЗначениеЗаполнено(Имя) Тогда
        Возврат Справочники.Подразделения.НайтиПоНаименованию(Строка(Имя), Истина);
    КонецЕсли;
    Возврат Справочники.Подразделения.ПустаяСсылка();
КонецФункции

Функция ЗначениеСтатуса(Текст)
    Ключ = НРег(СокрЛП(Текст));
    Соответствие = Новый Соответствие;
    Соответствие.Вставить("новая", "Новая");
    Соответствие.Вставить("назначена", "Назначена");
    Соответствие.Вставить("вработе", "ВРаботе");
    Соответствие.Вставить("в работе", "ВРаботе");
    Соответствие.Вставить("ожиданиематериалов", "ОжиданиеМатериалов");
    Соответствие.Вставить("ожидание материалов", "ОжиданиеМатериалов");
    Соответствие.Вставить("выполнена", "Выполнена");
    Соответствие.Вставить("закрыта", "Закрыта");
    Соответствие.Вставить("отменена", "Отменена");
    Имя = Соответствие.Получить(Ключ);
    Если Имя = Неопределено Тогда Имя = Текст; КонецЕсли;
    Возврат ПолучитьПеречисление("Статусы", Имя);
КонецФункции

Функция ЗначениеПриоритета(Текст)
    Ключ = НРег(СокрЛП(Текст));
    Соответствие = Новый Соответствие;
    Соответствие.Вставить("низкий", "Низкий");
    Соответствие.Вставить("обычный", "Обычный");
    Соответствие.Вставить("высокий", "Высокий");
    Соответствие.Вставить("срочный", "Срочный");
    Имя = Соответствие.Получить(Ключ);
    Если Имя = Неопределено Тогда Имя = Текст; КонецЕсли;
    Возврат ПолучитьПеречисление("Приоритет", Имя);
КонецФункции

Функция ЗначениеКатегории(Текст)
    // Поддерживаем существующее перечисление без его изменения.
    Разрешенные = Новый Массив;
    Разрешенные.Добавить("Электрика"); Разрешенные.Добавить("Сантехника"); Разрешенные.Добавить("Мебель");
    Разрешенные.Добавить("Отделка"); Разрешенные.Добавить("Кондиционер"); Разрешенные.Добавить("Окна");
    Разрешенные.Добавить("Двери"); Разрешенные.Добавить("Компьютер"); Разрешенные.Добавить("Другое");
    Если Разрешенные.Найти(Текст) = Неопределено Тогда Текст = "Другое"; КонецЕсли;
    Возврат ПолучитьПеречисление("Категория", Текст);
КонецФункции

Функция ПолучитьПеречисление(ИмяПеречисления, ИмяЗначения)
    Попытка
        Возврат ПредопределенноеЗначение("Перечисление." + ИмяПеречисления + "." + ИмяЗначения);
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

Функция ISOВДату(Текст)
    Попытка
        Т = СтрЗаменить(Лев(Текст, 19), "-", "");
        Т = СтрЗаменить(Т, "T", "");
        Т = СтрЗаменить(Т, ":", "");
        Т = СтрЗаменить(Т, " ", "");
        Если СтрДлина(Т) >= 14 Тогда
            Возврат Дата(Число(Лев(Т,4)), Число(Сред(Т,5,2)), Число(Сред(Т,7,2)), Число(Сред(Т,9,2)), Число(Сред(Т,11,2)), Число(Сред(Т,13,2)));
        КонецЕсли;
    Исключение
    КонецПопытки;
    Возврат Неопределено;
КонецФункции

Функция GUIDСсылки(Ссылка)
    Попытка
        Если НЕ ЗначениеЗаполнено(Ссылка) Тогда Возврат ""; КонецЕсли;
        Возврат Строка(Ссылка.УникальныйИдентификатор());
    Исключение
        Возврат "";
    КонецПопытки;
КонецФункции

Функция ИзJSON(Текст)
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Текст);
    Возврат ПрочитатьJSON(Чтение);
КонецФункции

Функция JSONОтвет(Код, Данные)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Тело = Запись.Закрыть();
    Ответ = Новый HTTPСервисОтвет(Код);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
    Возврат Ответ;
КонецФункции

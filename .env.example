APP_NAME=FMTS
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
DATABASE_URL=sqlite:///./toir.db
# Public HTTPS URL. Important for QR codes and links opened from phones.
# Render example: https://fmts-demo.onrender.com
PUBLIC_BASE_URL=
# Legacy compatibility only. Prefer PUBLIC_BASE_URL.
BASE_URL=
UPLOAD_DIR=./uploads
COOKIE_HTTPS_ONLY=false
# Photos attached to a comment
COMMENT_PHOTO_MAX_COUNT=5
COMMENT_PHOTO_MAX_MB=12
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeMe123!
INITIAL_ADMIN_NAME=Администратор
# Docker/PostgreSQL only
POSTGRES_PASSWORD=CHANGE_THIS_POSTGRES_PASSWORD

# Optional 1C connector. The standalone core does not require 1C.
ONEC_ENABLED=false
ONEC_AUTO_PUSH=false
# Webhook token is needed only when the 1C connector is enabled.
ONEC_WEBHOOK_TOKEN=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_TOKEN

# TOIR <-> 1C integration
ONEC_MODE=http_service
# Existing Apache/HTTPS publication of the 1C database, e.g. https://1c.company.kz/base
ONEC_BASE_URL=https://1c.example.kz/base
ONEC_USERNAME=toir_api
ONEC_PASSWORD=change-me
ONEC_VERIFY_SSL=true
ONEC_TIMEOUT=20
ONEC_SITES_PATH=/hs/toir/v1/sites
ONEC_EQUIPMENT_PATH=/hs/toir/v1/equipment
ONEC_INVENTORY_PATH=/hs/toir/v1/inventory
ONEC_TICKETS_PATH=/hs/toir/v1/tickets
ONEC_UI_PATH=/hs/toir/v1/ui

# Existing metadata names from the previous project
ONEC_TICKET_DOCUMENT=ЗаявкаХозОтдела
ONEC_DEPARTMENT_CATALOG=Подразделения
ONEC_STATUS_ENUM=Статусы
ONEC_PRIORITY_ENUM=Приоритет
ONEC_CATEGORY_ENUM=Категория

# Monthly KPI / technician rating (v0.5)
# Target weighted points per technician per month. 1 normal ticket = 1 point.
KPI_MONTHLY_TARGET_POINTS=30
KPI_WEIGHT_SLA=0.40
KPI_WEIGHT_CLOSURE=0.25
KPI_WEIGHT_PRODUCTIVITY=0.20
KPI_WEIGHT_DOCUMENTATION=0.15

# --- Enterprise ServiceDesk v0.6 ---
ENTERPRISE_LOOP_SECONDS=60
SLA_WARNING_MINUTES=30

# Incoming e-mail -> tickets. Set default FMTS site ID for new e-mail tickets.
IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=true
IMAP_FOLDER=INBOX
IMAP_DEFAULT_SITE_ID=0

# Outgoing e-mail notifications and report subscriptions
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Telegram notifications. Each user may store Telegram chat ID in profile.
TELEGRAM_BOT_TOKEN=

# WhatsApp notifications via your provider's HTTPS webhook/API gateway.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=

# Web Push / PWA. Optional VAPID keys.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@example.com

# LDAP / Active Directory. Optional; local accounts continue to work.
LDAP_ENABLED=false
LDAP_SERVER=
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_BASE_DN=
LDAP_USERNAME_ATTR=sAMAccountName

# FMTS v0.7.2 AD/LDAP directory sync
LDAP_DISPLAY_NAME_ATTR=displayName
LDAP_EMAIL_ATTR=mail
LDAP_PHONE_ATTR=telephoneNumber
LDAP_DEPARTMENT_ATTR=department
LDAP_MANAGER_ATTR=manager
LDAP_SYNC_FILTER=(&(objectClass=user)(!(objectClass=computer)))

# Optional trusted reverse-proxy / IdP SSO gateway (disabled by default)
SSO_ENABLED=false
SSO_USER_HEADER=X-FMTS-User
SSO_SECRET_HEADER=X-FMTS-SSO-Secret
SSO_SHARED_SECRET=

EMAIL_STATUS_COMMANDS_ENABLED=true
EMAIL_ADD_RECIPIENTS_AS_OBSERVERS=true

# v0.7.4 — localization / Zabbix
DEFAULT_TIMEZONE=Asia/Almaty
DEFAULT_LOCALE=ru
ZABBIX_ENABLED=false
ZABBIX_URL=
ZABBIX_USERNAME=
ZABBIX_PASSWORD=
ZABBIX_TOKEN=
ZABBIX_DEFAULT_SITE_ID=0
ZABBIX_VERIFY_SSL=true
ZABBIX_SYNC_INTERVAL_MINUTES=60
